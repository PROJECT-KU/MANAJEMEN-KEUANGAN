APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# WAJIB benar di server: tautan verifikasi & atur ulang kata sandi dibuat dari
# nilai ini, dan tanda tangannya mencakup host. Kalau salah, tautan di email
# mengarah ke tempat keliru dan ditolak saat dibuka.
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Pembatas percobaan masuk disimpan terpisah supaya `php artisan cache:clear`
# saat deploy tidak melepas penguncian akun yang sedang berjalan.
CACHE_LIMITER=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
# Masa diam sebelum sesi berakhir (menit). Laravel memperbarui hitungannya
# pada setiap permintaan, jadi ini benar-benar batas diam, bukan batas total.
SESSION_LIFETIME=120
# Wajib true di produksi (HTTPS): kue sesi tidak boleh terkirim lewat HTTP biasa.
SESSION_SECURE_COOKIE=false
# 'lax' menahan kue sesi ikut terkirim pada permintaan lintas situs.
SESSION_SAME_SITE=lax
# Masa berlaku "ingat saya" (menit). Bawaan Laravel lima tahun; di sini 30 hari.
INGAT_SAYA_MENIT=43200

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (Hostinger). Port 465 memakai TLS penuh dan Laravel 12 membacanya dari
# MAIL_SCHEME=smtps -- MAIL_ENCRYPTION sudah tidak dipakai lagi.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=halo@rumahscopusfoundation.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=halo@rumahscopusfoundation.com
MAIL_FROM_NAME="Rumah Scopus Foundation"

# Untuk pengembangan lokal sebaiknya pakai penangkap email supaya tidak ada
# surat yang benar-benar terkirim ke pengguna asli:
#   brew install mailpit && mailpit        (kotak masuk http://127.0.0.1:8025)
#   MAIL_HOST=127.0.0.1
#   MAIL_PORT=1025
#   MAIL_SCHEME=
#   MAIL_USERNAME=
#   MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
