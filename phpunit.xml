<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
          Batas memorinya dinaikkan dari 256M bawaan PHP CLI.

          Suitenya melewatinya di sekitar seribu seratus uji: galatnya muncul
          di FileinfoMimeTypeGuesser saat satu uji unggahan menebak jenis
          berkas 7 MB, dan prosesnya MATI DI TENGAH JALAN — hasilnya terpotong
          sebelum daftar kegagalan tercetak, jadi uji yang benar-benar merah
          tidak pernah terbaca. Yang terlihat cuma "N failed" tanpa namanya.

          Ditaruh di sini, bukan lewat `php -d`: `artisan test` menjalankan
          PHPUnit di proses ANAK, dan -d pada proses induk tidak sampai ke
          sana — terukur, galatnya tetap menyebut 268435456.
        -->
        <ini name="memory_limit" value="1024M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>

        <!--
            Pembatas laju DIPAKSA ke ingatan proses.

            config/cache.php menyetel `limiter` ke 'database' secara terpisah
            dari `default`, jadi CACHE_DRIVER=array di atas TIDAK menyentuhnya:
            hitungan throttle ditulis ke tabel `cache` yang sungguhan dan
            bertahan antar jalankan rangkaian uji.

            Akibatnya terukur 31 Okt 2026. Batas 'isi-otomatis' adalah 25 per
            HARI per alamat IP; menjalankan rangkaiannya beberapa kali dalam
            satu hari menghabiskan jatah 127.0.0.1, lalu dua uji pencarian
            nomor memerah dengan 429 — tanpa satu baris kode pun berubah, dan
            hijau lagi keesokan harinya. Dijaga PembatasLajuUjiTest.
        -->
        <env name="CACHE_LIMITER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!--
            Pembayaran daring DIMATIKAN di rangkaian uji.

            Tanpa ini, ujinya ikut berubah perilaku begitu seseorang mengisi
            kunci DOKU di .env miliknya: borang pendaftaran berhenti memakai
            transfer manual dan beralih ke gerbang pembayaran, lalu sembilan
            uji merah di mesin itu saja — sementara di mesin lain tetap hijau.
            Terjadi persis begitu 17 Okt 2026.

            Uji yang memang menguji DOKU menyalakannya sendiri lewat
            config()->set(), jadi ia tidak bergantung keadaan .env siapa pun.
        -->
        <env name="DOKU_CLIENT_ID" value=""/>
        <env name="DOKU_SECRET_KEY" value=""/>

        <!--
            WhatsApp DIMATIKAN di rangkaian uji, dan ini bukan sekadar
            kebersihan.

            Tokennya di .env seseorang berarti rangkaian uji MENGIRIM
            WHATSAPP SUNGGUHAN — ke nomor-nomor yang ada di data uji, yang
            sebagian nomor orang betulan — dan ikut menghabiskan kuota
            1.000 pesan/bulan paket gratisnya. Sekali jalan penuh bisa
            memakan puluhan pesan.

            Uji yang memang menguji Fonnte menyalakannya sendiri lewat
            config()->set() DAN Http::fake(), jadi tidak satu pun
            permintaan keluar.
        -->
        <env name="FONNTE_TOKEN" value=""/>

        <!--
            Jedanya NOL di rangkaian uji.

            Sapuan kedaluwarsa menjeda 25 detik antar pesan supaya nomornya
            tidak terbaca sebagai penyiar. Dibiarkan hidup di sini, satu uji
            dengan tujuh baris kedaluwarsa akan benar-benar tidur dua setengah
            menit — dan rangkaian yang lambat adalah rangkaian yang berhenti
            dijalankan orang.
        -->
        <env name="FONNTE_JEDA_SAPUAN_DETIK" value="0"/>
    </php>
</phpunit>
